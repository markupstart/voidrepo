# Template file for 'hip-runtime-amd'
pkgname=hip-runtime-amd
version=7.14.0
revision=1
build_style=cmake
build_wrksrc=projects/clr
_amdgpu_targets="${AMDGPU_TARGETS:-gfx1100;gfx1101;gfx1102}"
configure_args="
 -G Ninja
 -DCMAKE_BUILD_TYPE=Release
 -DCMAKE_INSTALL_PREFIX=/usr
 -DCLR_BUILD_HIP=ON
 -DHIP_PLATFORM=amd
 -DOpenGL_GL_PREFERENCE=GLVND
 -DAMDGPU_TARGETS=${_amdgpu_targets}
 -DHIPCC_BIN_DIR=
 -DUSE_PROF_API=OFF
 -DHIP_ENABLE_ROCPROFILER_REGISTER=OFF
 -DBUILD_TESTING=OFF
"
hostmakedepends="cmake ninja pkg-config python3 perl rocm-cmake rocm-llvm rocm-comgr"
makedepends="rocr-runtime rocm-llvm rocm-device-libs rocm-comgr libglvnd-devel"
depends="rocr-runtime rocm-llvm rocm-device-libs rocm-comgr"
short_desc="HIP runtime for AMD GPUs"
maintainer="mark <mark@local>"
license="MIT"
homepage="https://github.com/ROCm/rocm-systems/tree/therock-7.14/projects/clr"
distfiles="https://github.com/ROCm/rocm-systems/archive/refs/tags/therock-7.14.tar.gz"
checksum=8cadf0d5c0f53f334b7b940a78619d1746c913b26ae719e2a09e20a6f7128330

pre_configure() {
 configure_args+=" -DHIP_COMMON_DIR=${wrksrc}/projects/hip"
}

post_extract() {
 local hipamd_cmakelists="${wrksrc}/projects/clr/hipamd/CMakeLists.txt"

 if [[ -f "${hipamd_cmakelists}" ]] && ! grep -q '^cmake_minimum_required' "${hipamd_cmakelists}"; then
  sed -i '1i cmake_minimum_required(VERSION 3.5)' "${hipamd_cmakelists}"
 fi
}

# Notes:
# 1) For production packaging, you will likely split this into runtime and devel subpackages.
# 2) rocm-device-libs is included here because it is commonly required by HIP stacks.
# 3) ROCm docs map this under the rocm-hip-runtime meta-package.
# 4) Override defaults by exporting AMDGPU_TARGETS, e.g. AMDGPU_TARGETS="gfx1100".

# Template file for 'hipcc'
pkgname=hipcc
version=7.14.0
revision=1
build_style=cmake
build_wrksrc=amd/hipcc
configure_args="
 -G Ninja
 -DCMAKE_BUILD_TYPE=Release
 -DCMAKE_INSTALL_PREFIX=/usr
 -DROCM_DEP_ROCMCORE=OFF
 -DHIPCC_BACKWARD_COMPATIBILITY=ON
"
hostmakedepends="cmake ninja pkg-config python3 perl"
makedepends="rocm-llvm"
depends="hip-runtime-amd rocm-llvm"
short_desc="HIP compiler compatibility wrapper (hipcc and hipconfig)"
maintainer="mark <mark@local>"
license="MIT"
homepage="https://github.com/ROCm/llvm-project/tree/therock-7.14/amd/hipcc"
distfiles="https://github.com/ROCm/llvm-project/archive/refs/tags/therock-7.14.tar.gz"
checksum=db365c1f0ab500eeee04a990d29d79a6bb667874f8069f7b69920ca62c352d2f

# Note: ROCm documents HIPCC as deprecated as of 7.2.0; AMD Clang is the preferred entry point.
# This package remains for compatibility with existing hipcc-based build flows.

post_install() {
 mv "${DESTDIR}/usr/bin/hipcc" "${DESTDIR}/usr/bin/hipcc.bin"
 mv "${DESTDIR}/usr/bin/hipconfig" "${DESTDIR}/usr/bin/hipconfig.bin"

 vinstall /dev/stdin 755 usr/bin hipcc <<'EOF'
#!/bin/sh
if [ -z "${HIP_CLANG_PATH:-}" ]; then
	if [ -n "${ROCM_PATH:-}" ] && [ -x "${ROCM_PATH}/bin/clang++" ]; then
		export HIP_CLANG_PATH="${ROCM_PATH}/bin"
	elif [ ! -x /usr/lib/llvm/bin/clang++ ] && [ -x /usr/bin/clang++ ]; then
		export HIP_CLANG_PATH=/usr/bin
	fi
fi
bindir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec "${bindir}/hipcc.bin" "$@"
EOF

 vinstall /dev/stdin 755 usr/bin hipconfig <<'EOF'
#!/bin/sh
if [ -z "${HIP_CLANG_PATH:-}" ]; then
	if [ -n "${ROCM_PATH:-}" ] && [ -x "${ROCM_PATH}/bin/clang++" ]; then
		export HIP_CLANG_PATH="${ROCM_PATH}/bin"
	elif [ ! -x /usr/lib/llvm/bin/clang++ ] && [ -x /usr/bin/clang++ ]; then
		export HIP_CLANG_PATH=/usr/bin
	fi
fi
bindir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec "${bindir}/hipconfig.bin" "$@"
EOF
}
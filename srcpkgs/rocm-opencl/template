# Template file for 'rocm-opencl'
pkgname=rocm-opencl
version=7.14.0
revision=2
build_style=cmake
build_wrksrc=projects/clr
configure_args="
 -G Ninja
 -DCMAKE_BUILD_TYPE=Release
 -DCMAKE_INSTALL_PREFIX=/usr
 -DCLR_BUILD_OCL=ON
 -DROCM_PATH=/usr
 -DOpenGL_GL_PREFERENCE=GLVND
 -DBUILD_TESTS=OFF
 -DBUILD_ICD=OFF
"
hostmakedepends="cmake ninja pkg-config python3 perl rocm-llvm rocm-comgr"
makedepends="rocr-runtime rocm-llvm rocm-device-libs rocm-comgr libglvnd-devel"
depends="rocr-runtime rocm-llvm rocm-device-libs rocm-comgr ocl-icd"
short_desc="ROCm OpenCL runtime for AMD GPUs"
maintainer="mark <mark@local>"
license="MIT"
homepage="https://github.com/ROCm/rocm-systems/tree/therock-7.14/projects/clr"
distfiles="https://github.com/ROCm/rocm-systems/archive/refs/tags/therock-7.14.tar.gz"
checksum=8cadf0d5c0f53f334b7b940a78619d1746c913b26ae719e2a09e20a6f7128330

post_extract() {
 sed -i '/add_subdirectory(tools\/clinfo)/d' "${wrksrc}/projects/clr/opencl/CMakeLists.txt"
 sed -i '/install(TARGETS clinfo /d' "${wrksrc}/projects/clr/opencl/packaging/CMakeLists.txt"
 sed -i 's|/opt/rocm/lib|/usr/lib|' "${wrksrc}/projects/clr/opencl/packaging/rocm-opencl.conf"
}

post_install() {
 local icd_lib=
 local icd_entry=
 local search_dirs=(
  "${DESTDIR}/usr/lib64/opencl"
  "${DESTDIR}/usr/lib/opencl"
  "${DESTDIR}/usr/lib64"
  "${DESTDIR}/usr/lib"
 )

 for dir in "${search_dirs[@]}"; do
  [[ -d "${dir}" ]] || continue
  for cand in libamdocl64.so libamdocl12cl64.so libamdocl-orca64.so; do
   if [[ -e "${dir}/${cand}" ]]; then
    icd_lib="${cand}"
    icd_entry="${dir#${DESTDIR}}/${cand}"
    break 2
   fi
  done
 done

 if [[ -z "${icd_entry}" ]]; then
  for dir in "${search_dirs[@]}"; do
   [[ -d "${dir}" ]] || continue
   for so in "${dir}"/libamdocl*.so; do
    if [[ -e "${so}" ]]; then
     icd_lib="$(basename "${so}")"
     icd_entry="${so#${DESTDIR}}"
     break 2
    fi
   done
  done
 fi

 if [[ -z "${icd_entry}" ]]; then
  msg_error "No libamdocl*.so found in ${DESTDIR}/usr/lib{,64}{,/opencl}; cannot generate OpenCL ICD file.\n"
 fi

 vinstall /dev/stdin 644 etc/OpenCL/vendors amdocl64.icd <<EOF
${icd_entry}
EOF
 vinstall /dev/stdin 644 etc/ld.so.conf.d 10-rocm-opencl.conf <<'EOF'
/usr/lib64/opencl
/usr/lib/opencl
/usr/lib64
/usr/lib
EOF
}

# Template file for 'zen-browser'
pkgname=zen-browser
version=1.21.8b
revision=1
archs="x86_64 aarch64"
short_desc="Calmer, more privacy-focused Firefox-based browser"
maintainer="Mark <mark@example.com>"
license="MPL-2.0"
homepage="https://zen-browser.com"
changelog="https://github.com/zen-browser/desktop/releases"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-${XBPS_TARGET_MACHINE}.tar.xz"
checksum="05a36657e4c9dbe700e54a2e3941f7af4656abbe330690aa74d8cf793af396f4
 0586ff279d7a1f93207fdb195c5586ef0d6813bd4f4318badcd0984adc39db39"

create_wrksrc=yes
lib32disabled=yes
depends="gtk+3 libXrender libXcomposite libXdamage libXfixes libX11 libXtst dbus
 libnotify"

do_install() {
	# Install browser to /opt/zen-browser
	vmkdir opt/zen-browser
	vcopy "*" opt/zen-browser

	# Create wrapper script for /usr/bin
	cat > zen-browser-wrapper <<-EOF
	#!/bin/sh
	exec /opt/zen-browser/zen/zen "\$@"
	EOF
	vbin zen-browser-wrapper zen-browser

	# Install desktop file
	vinstall "${FILESDIR}/zen-browser.desktop" 644 usr/share/applications

	# Install icons
	for size in 16 32 48 64 128; do
		if [ -f "browser/chrome/icons/default/default${size}.png" ]; then
			vinstall browser/chrome/icons/default/default${size}.png 644 \
				usr/share/icons/hicolor/${size}x${size}/apps zen-browser.png
		fi
	done
}
zen-browser_package() {
 vmove usr
 vmove opt
}